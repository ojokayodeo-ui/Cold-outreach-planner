# ── Required ──────────────────────────────────────────────────────────────────
# Powers all AI synthesis and message generation
ANTHROPIC_API_KEY=sk-ant-...

# ── Live Research Tools (highly recommended) ──────────────────────────────────

# Perplexity API — real-time web search for market research + ICP enrichment
# Get yours at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# Proxycurl — LinkedIn company + people profile scraping for real persona data
# Get yours at https://nubela.co/proxycurl
PROXYCURL_API_KEY=...

# ── Optional future integrations ──────────────────────────────────────────────
# Serper.dev — Google search results API (supplement to Perplexity)
# SERPER_API_KEY=...

# Firecrawl — deep website scraping
# FIRECRAWL_API_KEY=...
